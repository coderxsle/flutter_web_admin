# 环境变量 (命名必须以 VITE_ 开头)

# 接口前缀 —— 指向后端 **REST 表现层**（webServer，开发环境 8082）。
# 业务路径统一挂在这个前缀下：`/api/user`、`/api/dictData`、`/api/auth/login` …
# ⚠️ 不再是 typed Endpoint 的 8080；8082 与 8080 是**同一个进程**的两个端口。
VITE_API_PREFIX = 'http://localhost:8082/api'

# 接口地址（同上，留给需要自行拼接完整 URL 的场景）
VITE_API_BASE_URL = 'http://localhost:8082/api'

# 开发环境地址前缀 (一般 '/' 或 './' 都可以)
VITE_BASE = '/'
