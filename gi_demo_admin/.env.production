# 环境变量 (命名必须以 VITE_ 开头)

# 接口前缀 —— 指向后端 **REST 表现层**。
# ⚠️ 生产用相对路径 `/api`，所以**必须由 nginx（或其它网关）把 `/api` 反代到
#    webServer 的 8082 端口**，不是 apiServer 的 8080：
#      location /api/ { proxy_pass http://127.0.0.1:8082/api/; }
#    漏了这一步会全站 404。
VITE_API_PREFIX = '/api'

# 接口地址（需要直连后端时填完整地址，注意同样要带 `/api` 前缀）
VITE_API_BASE_URL = 'http://localhost:8082/api'

# 打包路径 (就是网站前缀, 例如部署到 http://lin0716.gitee.io/gi-demo/ 域名下, 就需要填写 /gi-demo/)
VITE_BASE = '/gi-demo/'
